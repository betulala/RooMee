@page
@model LogoutModel
@{
    ViewData["Title"] = "Çıkış yap";
}

<div class="text-center py-4">
    <h1 class="h3">@ViewData["Title"]</h1>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
            <button type="submit" class="btn btn-primary">Çıkış yapmak için tıkla</button>
        </form>
    }
    else
    {
        <p class="text-muted">Başarıyla çıkış yaptın.</p>
        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfaya dön</a>
    }
</div>
