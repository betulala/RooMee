@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "E-postanı kontrol et";
}

<div class="text-center py-4">
    <h1 class="h3">@ViewData["Title"]</h1>
    <p class="text-muted">
        Bu adrese ait bir hesap varsa şifre sıfırlama bağlantısı gönderdik.<br />
        Gelen kutunu (ve spam klasörünü) kontrol et.
    </p>
    <a asp-page="./Login" class="btn btn-primary">Giriş sayfasına git</a>
</div>
