@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Kaydın alındı";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5 text-center">
        <h1 class="h3 mb-3">Kaydın alındı</h1>
        <p>E-posta adresine bir onay bağlantısı gönderdik. Gelen kutunu (ve spam klasörünü) kontrol et; bağlantıya tıkladıktan sonra giriş yapabilirsin.</p>
        @if (Model.DisplayConfirmAccountLink)
        {
            <p class="small text-muted">Geliştirme modu: <a id="confirm-link" href="@Model.EmailConfirmationUrl">Hesabı onayla</a></p>
        }
        <a asp-page="./Login" class="btn btn-primary mt-2">Giriş sayfasına git</a>
    </div>
</div>