@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Şifremi unuttum";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-4">E-posta adresini yaz, şifreni sıfırlaman için bir bağlantı gönderelim.</p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ornek@mail.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Sıfırlama bağlantısı gönder</button>
            <p class="text-center mt-3"><a asp-page="./Login">Giriş sayfasına dön</a></p>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
