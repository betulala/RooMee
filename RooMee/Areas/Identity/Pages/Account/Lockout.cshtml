@page
@model LockoutModel
@{
    ViewData["Title"] = "Hesap geçici olarak kilitlendi";
}

<div class="text-center py-4">
    <h1 class="h3 text-danger">@ViewData["Title"]</h1>
    <p class="text-muted">
        Çok sayıda hatalı giriş denemesi yapıldığı için hesabın 10 dakikalığına kilitlendi.<br />
        Lütfen biraz sonra tekrar dene ya da <a asp-page="./ForgotPassword">şifreni sıfırla</a>.
    </p>
</div>
