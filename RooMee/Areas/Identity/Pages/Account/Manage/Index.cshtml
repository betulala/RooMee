@page
@model IndexModel
@{
    ViewData["Title"] = "Hesap bilgileri";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="h5">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="row">
    <div class="col-md-8">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Username" class="form-control" placeholder="Kullanıcı adı" disabled />
                <label asp-for="Username" class="form-label"></label>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Telefon numaran" />
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>
            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Kaydet</button>
        </form>
        <p class="small text-muted mt-3">
            Ad, üniversite, bütçe gibi bilgilerini <a asp-area="" asp-controller="Profil" asp-action="Duzenle">profilinden</a> düzenleyebilirsin.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
