@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Kurtarma kodları oluştur";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="h5">@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p><strong>Bu kodları güvenli bir yerde sakla.</strong></p>
    <p>Telefonunu kaybedersen ve kurtarma kodların da yoksa hesabına giremezsin.</p>
    <p class="mb-0">
        Yeni kod oluşturmak doğrulama uygulamasındaki anahtarı değiştirmez. Anahtarı değiştirmek istersen
        <a asp-page="./ResetAuthenticator">doğrulama anahtarını sıfırla</a>.
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Kurtarma kodları oluştur</button>
    </form>
</div>
