@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Kişisel veriler";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="h5">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-8">
        <p>
            Hesabında bize verdiğin kişisel veriler bulunur. KVKK kapsamında bu verilerin bir kopyasını indirebilir
            ya da hesabını ve tüm verilerini silebilirsin.
        </p>
        <p>
            <strong>Verilerini silmek hesabını kalıcı olarak kapatır ve bu işlem geri alınamaz.</strong>
        </p>
        <div class="d-flex flex-wrap gap-2">
            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <button class="btn btn-primary" type="submit">Verilerimi indir</button>
            </form>
            <a id="delete" asp-area="" asp-controller="Profil" asp-action="HesapSil" class="btn btn-danger">Hesabımı sil</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
