@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = "İki adımlı doğrulama";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="h5">@ViewData["Title"]</h3>
<p class="text-muted small">Girişte şifrene ek olarak telefonundaki doğrulama uygulamasından bir kod istenir. Hesabını daha güvenli yapar.</p>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            if (Model.RecoveryCodesLeft == 0)
            {
                <div class="alert alert-danger">
                    <strong>Hiç kurtarma kodun kalmadı.</strong>
                    <p class="mb-0">Kurtarma koduyla giriş yapabilmek için <a asp-page="./GenerateRecoveryCodes">yeni kurtarma kodları oluşturmalısın</a>.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft == 1)
            {
                <div class="alert alert-danger">
                    <strong>Sadece 1 kurtarma kodun kaldı.</strong>
                    <p class="mb-0"><a asp-page="./GenerateRecoveryCodes">Yeni kurtarma kodları oluşturabilirsin</a>.</p>
                </div>
            }
            else if (Model.RecoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning">
                    <strong>@Model.RecoveryCodesLeft kurtarma kodun kaldı.</strong>
                    <p class="mb-0"><a asp-page="./GenerateRecoveryCodes">Yeni kurtarma kodları oluşturman</a> iyi olur.</p>
                </div>
            }

            <div class="d-flex flex-wrap gap-2 mb-3">
                @if (Model.IsMachineRemembered)
                {
                    <form method="post">
                        <button type="submit" class="btn btn-outline-primary">Bu tarayıcıyı unut</button>
                    </form>
                }
                <a asp-page="./Disable2fa" class="btn btn-outline-danger">İki adımlı doğrulamayı kapat</a>
                <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-primary">Kurtarma kodlarını yenile</a>
            </div>
        }

        <h4 class="h6 mt-3">Doğrulama uygulaması</h4>
        @if (!Model.HasAuthenticator)
        {
            <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Doğrulama uygulaması ekle</a>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                <a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn btn-primary">Doğrulama uygulamasını kur</a>
                <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-outline-primary">Doğrulama uygulamasını sıfırla</a>
            </div>
        }
    }
    else
    {
        <div class="alert alert-danger">
            <strong>Gizlilik ve çerez politikası kabul edilmedi.</strong>
            <p class="mb-0">İki adımlı doğrulamayı açabilmek için önce politikayı kabul etmelisin.</p>
        </div>
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
