@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="sayfa-ust">
    <span class="ust-etiket">Hesabım</span>
    <h1>Hesap ayarları</h1>
    <p>E-posta, şifre ve hesap güvenliği ayarlarını buradan yönetebilirsin.</p>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="form-kart p-2">
            <partial name="_ManageNav" />
        </div>
    </div>
    <div class="col-md-9">
        <div class="form-kart">
            @RenderBody()
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
