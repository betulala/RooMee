@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Kurtarma kodları";
    ViewData["ActivePage"] = "TwoFactorAuthentication";
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="h5">@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p><strong>Bu kodları güvenli bir yerde sakla.</strong></p>
    <p class="mb-0">Telefonunu kaybedersen ve kurtarma kodların da yoksa hesabına giremezsin.</p>
</div>
<div class="row">
    <div class="col-md-12">
        @for (var row = 0; row < (Model.RecoveryCodes?.Length ?? 0); row += 2)
        {
            <code class="recovery-code">@Model.RecoveryCodes![row]</code><text>&nbsp;</text><code class="recovery-code">@Model.RecoveryCodes[row + 1]</code><br />
        }
    </div>
</div>
