@model string

@if (!String.IsNullOrEmpty(Model))
{
    // Hata bildiren mesajlar kırmızı, diğerleri yeşil görünür
    var hataKelimeleri = new[] { "hata", "onaylanamadı", "kaldırılamadı", "eklenemedi", "yüklenemedi" };
    var hata = hataKelimeleri.Any(k => Model.Contains(k, StringComparison.OrdinalIgnoreCase));
    <div class="alert alert-@(hata ? "danger" : "success") alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        @Model
    </div>
}
