@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Doğrulama anahtarını sıfırla";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="h5">@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p><strong>Anahtarı sıfırlarsan doğrulama uygulaman, tekrar kurana kadar çalışmaz.</strong></p>
    <p class="mb-0">
        Bu işlem, uygulamanı yeniden doğrulayana kadar iki adımlı doğrulamayı kapatır.
        Kurulumu tamamlamazsan hesabına erişimi kaybedebilirsin.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Anahtarı sıfırla</button>
    </form>
</div>
