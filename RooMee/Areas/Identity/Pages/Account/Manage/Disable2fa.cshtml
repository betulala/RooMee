@page
@model Disable2faModel
@{
    ViewData["Title"] = "İki adımlı doğrulamayı kapat";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="h5">@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p><strong>Bu işlem sadece iki adımlı doğrulamayı kapatır.</strong></p>
    <p class="mb-0">
        Doğrulama uygulamasındaki anahtar değişmez. Anahtarı değiştirmek istersen
        <a asp-page="./ResetAuthenticator">doğrulama anahtarını sıfırla</a>.
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">İki adımlı doğrulamayı kapat</button>
    </form>
</div>
