@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Doğrulama uygulamasını kur";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3 class="h5">@ViewData["Title"]</h3>
<div>
    <p>Doğrulama uygulamasını kullanmak için şu adımları izle:</p>
    <ol class="list">
        <li>
            <p>
                Telefonuna Microsoft Authenticator
                (<a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a>,
                <a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a>) ya da Google Authenticator
                (<a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=tr">Android</a>,
                <a href="https://apps.apple.com/tr/app/google-authenticator/id388497605">iOS</a>) gibi bir doğrulama uygulaması indir.
            </p>
        </li>
        <li>
            <p>QR kodunu okut ya da şu anahtarı uygulamaya gir: <kbd>@Model.SharedKey</kbd> (boşluklar ve büyük/küçük harf önemli değil).</p>
            <div id="qrCode"></div>
            <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
        </li>
        <li>
            <p>Uygulama sana 6 haneli bir kod verecek. O kodu aşağıya yaz.</p>
            <div class="row">
                <div class="col-md-6">
                    <form id="send-code" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Code" class="form-control" autocomplete="off" placeholder="Kod" />
                            <label asp-for="Input.Code" class="control-label form-label">Doğrulama kodu</label>
                            <span asp-validation-for="Input.Code" class="text-danger"></span>
                        </div>
                        <button type="submit" class="w-100 btn btn-lg btn-primary">Doğrula</button>
                        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    </form>
                </div>
            </div>
        </li>
    </ol>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
