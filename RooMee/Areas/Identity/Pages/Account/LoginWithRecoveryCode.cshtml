@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Kurtarma koduyla giriş";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-muted mb-4">
            Kurtarma kodlarından birini gir. Bu giriş, doğrulama uygulamasıyla tekrar giriş yapana kadar hatırlanmaz.
        </p>
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.RecoveryCode" class="form-label"></label>
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Giriş yap</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
