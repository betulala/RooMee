@model KullaniciFiltreViewModel
@{
    ViewData["Title"] = "Ev Arkadaşları";

    bool Secili<T>(List<T> liste, T deger) => liste.Contains(deger);
    bool Acik(params bool[] doluMu) => doluMu.Any(x => x);

    var tr = new System.Globalization.CultureInfo("tr-TR");
    string Tl(int? n) => n.HasValue ? n.Value.ToString("N0", tr) + "₺" : "Belirtilmemiş";
}
@functions {
    // Sayfa bağlantılarında mevcut filtreleri korur (Uyku=Sabahci&Uyku=Gececi gibi çoklu değerler dahil)
    string SayfaAdresi(int sayfa)
    {
        var parcalar = Context.Request.Query
            .Where(k => k.Key != "Sayfa")
            .SelectMany(k => k.Value.Select(v => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}"))
            .Append($"Sayfa={sayfa}");
        return Url.Action("Index")! + "?" + string.Join("&", parcalar);
    }
}

<div>
    <div class="sayfa-ust">
        <span class="ust-etiket">Ev Arkadaşları</span>
        <h1>Sana uygun ev arkadaşını bul</h1>
        <p>Konum, bütçe, yaşam tarzı ve ilgi alanlarına göre filtrele.</p>
    </div>

    <div class="ea-yerlesim">
        <!-- FİLTRE PANELİ -->
        <aside class="filtre-paneli" aria-label="Filtreler">
            <form id="filtre-form" asp-action="Index" method="get" autocomplete="off">

                <div class="filtre-grup">
                    <label class="filtre-baslik" for="f-sehir">Lokasyon</label>
                    <select id="f-sehir" name="Sehir">
                        <option value="">Şehir: Tümü</option>
                        @foreach (var (sehir, sayi) in Model.Sehirler)
                        {
                            <option value="@sehir" selected="@(Model.Sehir == sehir)">@sehir (@sayi)</option>
                        }
                    </select>
                </div>

                <div class="filtre-grup">
                    <span class="filtre-baslik">Bütçe (₺)</span>
                    <div class="ikili">
                        <input type="number" name="ButceMin" value="@Model.ButceMin" min="0" step="500" placeholder="Minimum" aria-label="En düşük bütçe" />
                        <input type="number" name="ButceMax" value="@Model.ButceMax" min="0" step="500" placeholder="Maksimum" aria-label="En yüksek bütçe" />
                    </div>
                </div>

                <span class="filtre-baslik">Gelişmiş Filtreler</span>

                <details class="acc" open="@Acik(Model.YasMin.HasValue, Model.YasMax.HasValue, Model.Cinsiyet.Any(), Model.Statu.Any(), Model.SadeceDogrulanmis)">
                    <summary><span>👤 Kişisel Bilgiler</span></summary>
                    <div class="acc-govde">
                        <p class="alt-baslik">Yaş aralığı</p>
                        <div class="ikili">
                            <input type="number" name="YasMin" value="@Model.YasMin" min="17" max="70" placeholder="En az" aria-label="En düşük yaş" />
                            <input type="number" name="YasMax" value="@Model.YasMax" min="17" max="70" placeholder="En çok" aria-label="En yüksek yaş" />
                        </div>
                        <p class="alt-baslik">Cinsiyet</p>
                        @foreach (var c in Enum.GetValues<Cinsiyet>())
                        {
                            <div class="kutu-satir">
                                <input type="checkbox" name="Cinsiyet" value="@c" id="c-@c" checked="@Secili(Model.Cinsiyet, c)" />
                                <label for="c-@c">@c.GorunenAd()</label>
                            </div>
                        }
                        <p class="alt-baslik">Statü</p>
                        <div class="kutu-satir"><input type="checkbox" name="Statu" value="ogrenci" id="s-ogr" checked="@Model.Statu.Contains("ogrenci")" /><label for="s-ogr">Öğrenci</label></div>
                        <div class="kutu-satir"><input type="checkbox" name="Statu" value="calisan" id="s-cal" checked="@Model.Statu.Contains("calisan")" /><label for="s-cal">Çalışan</label></div>
                        <div class="kutu-satir"><input type="checkbox" name="SadeceDogrulanmis" value="true" id="f-dogru" checked="@Model.SadeceDogrulanmis" /><label for="f-dogru">Sadece doğrulanmış öğrenciler</label></div>
                    </div>
                </details>

                <details class="acc" open="@Acik(!string.IsNullOrEmpty(Model.Universite), !string.IsNullOrEmpty(Model.Q))">
                    <summary><span>🎓 Eğitim Bilgileri</span></summary>
                    <div class="acc-govde">
                        <p class="alt-baslik">Üniversite</p>
                        <select name="Universite" aria-label="Üniversite">
                            <option value="">Tümü</option>
                            @foreach (var u in Model.Universiteler)
                            {
                                <option value="@u" selected="@(Model.Universite == u)">@u</option>
                            }
                        </select>
                        <p class="alt-baslik">Bölüm / Meslek</p>
                        <input type="text" name="Q" value="@Model.Q" placeholder="örn. Bilgisayar, Hemşire" aria-label="Bölüm veya meslek" />
                    </div>
                </details>

                <details class="acc" open="@Acik(Model.Uyku.Any(), Model.Calisma.Any(), Model.Hayvan.Any(), Model.Sigara.Any())">
                    <summary><span>👥 Yaşam Tercihleri</span></summary>
                    <div class="acc-govde">
                        <p class="alt-baslik">Uyku düzeni</p>
                        @foreach (var x in Enum.GetValues<UykuDuzeni>())
                        {
                            <div class="kutu-satir">
                                <input type="checkbox" name="Uyku" value="@x" id="u-@x" checked="@Secili(Model.Uyku, x)" />
                                <label for="u-@x">@(x == UykuDuzeni.Esnek ? "Esnek" : x.GorunenAd())</label>
                            </div>
                        }
                        <p class="alt-baslik">Ders / çalışma düzeni</p>
                        @foreach (var x in Enum.GetValues<CalismaDuzeni>())
                        {
                            <div class="kutu-satir">
                                <input type="checkbox" name="Calisma" value="@x" id="w-@x" checked="@Secili(Model.Calisma, x)" />
                                <label for="w-@x">@(x == CalismaDuzeni.Esnek ? "Fark etmez" : x.GorunenAd())</label>
                            </div>
                        }
                        <p class="alt-baslik">Evcil hayvan</p>
                        @foreach (var x in Enum.GetValues<EvcilHayvanDurumu>())
                        {
                            <div class="kutu-satir">
                                <input type="checkbox" name="Hayvan" value="@x" id="h-@x" checked="@Secili(Model.Hayvan, x)" />
                                <label for="h-@x">@x.GorunenAd()</label>
                            </div>
                        }
                        <p class="alt-baslik">Sigara</p>
                        <div class="kutu-satir"><input type="checkbox" name="Sigara" value="icmiyor" id="g-icmiyor" checked="@Model.Sigara.Contains("icmiyor")" /><label for="g-icmiyor">İçmez</label></div>
                        <div class="kutu-satir"><input type="checkbox" name="Sigara" value="icer" id="g-icer" checked="@Model.Sigara.Contains("icer")" /><label for="g-icer">İçer</label></div>
                    </div>
                </details>

                <details class="acc" open="@Acik(Model.Tur.Any(), Model.Oda.Any())">
                    <summary><span>🏠 Oda Tercihleri</span></summary>
                    <div class="acc-govde">
                        <p class="alt-baslik">İlan türü</p>
                        @foreach (var x in Enum.GetValues<AramaTuru>())
                        {
                            <div class="kutu-satir">
                                <input type="checkbox" name="Tur" value="@x" id="t-@x" checked="@Secili(Model.Tur, x)" />
                                <label for="t-@x">@x.GorunenAd()</label>
                            </div>
                        }
                        <p class="alt-baslik">Oda tipi</p>
                        @foreach (var x in Enum.GetValues<TercihOdaTipi>())
                        {
                            <div class="kutu-satir">
                                <input type="checkbox" name="Oda" value="@x" id="o-@x" checked="@Secili(Model.Oda, x)" />
                                <label for="o-@x">@x.GorunenAd()</label>
                            </div>
                        }
                    </div>
                </details>

                <details class="acc" open="@Acik(Model.Hobi.Any())">
                    <summary><span>⭐ Hobiler &amp; İlgi Alanları</span></summary>
                    <div class="acc-govde">
                        @for (int i = 0; i < Hobiler.Liste.Length; i++)
                        {
                            var h = Hobiler.Liste[i];
                            <div class="kutu-satir">
                                <input type="checkbox" name="Hobi" value="@h" id="hb-@i" checked="@Model.Hobi.Contains(h)" />
                                <label for="hb-@i">@h</label>
                            </div>
                        }
                    </div>
                </details>

                <input type="hidden" name="Siralama" id="f-siralama-gizli" value="@Model.Siralama" />

                <div class="filtre-butonlar">
                    <button class="ea-btn ea-btn-ana" type="submit">🔍 Uygula</button>
                    <a class="ea-btn ea-btn-sade" asp-action="Index">Filtreleri Temizle</a>
                </div>
            </form>
        </aside>

        <!-- SONUÇLAR -->
        <section id="sonuclar" aria-label="Sonuçlar">
            <div class="sonuc-ust">
                <p aria-live="polite"><strong>@Model.ToplamSayi</strong> kişi bulundu</p>
                <label class="visually-hidden" for="f-sirala">Sırala</label>
                <select id="f-sirala" class="siralama">
                    <option value="" selected="@string.IsNullOrEmpty(Model.Siralama)">En yeni</option>
                    <option value="eski" selected="@(Model.Siralama == "eski")">En eski</option>
                    @if (Model.UyumHesaplanabilir)
                    {
                        <option value="uyum" selected="@(Model.Siralama == "uyum")">En uyumlu</option>
                    }
                    <option value="butce-artan" selected="@(Model.Siralama == "butce-artan")">Bütçe (artan)</option>
                    <option value="butce-azalan" selected="@(Model.Siralama == "butce-azalan")">Bütçe (azalan)</option>
                    <option value="yas-artan" selected="@(Model.Siralama == "yas-artan")">Yaş (küçükten büyüğe)</option>
                </select>
            </div>

            @if (Model.UyumHesaplanabilir)
            {
                <p class="not">Uyum yüzdesi, profilindeki tercihlerine (uyku, çalışma düzeni, evcil hayvan, sigara, bütçe, yaş, hobiler) göre hesaplanır.</p>
            }
            else if (Model.GirisYapti)
            {
                <p class="not">Uyum yüzdesini görmek için <a asp-controller="Profil" asp-action="Duzenle">profilindeki yaşam tercihlerini</a> doldur.</p>
            }
            else
            {
                <p class="not"><a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)">Giriş yaparsan</a> her kişiyle uyum yüzdeni görebilirsin.</p>
            }

            @if (!Model.Sonuclar.Any())
            {
                <div class="bos-durum">
                    <h3 class="h5">Uygun kullanıcı bulunamadı</h3>
                    <p>Filtrelerini genişletmeyi deneyebilirsin.</p>
                </div>
            }
            else
            {
                <div class="kart-izgara">
                    @foreach (var k in Model.Sonuclar)
                    {
                        <partial name="_KisiKarti" model="k" />
                    }
                </div>

                @if (Model.ToplamSayfa > 1)
                {
                    <nav aria-label="Sayfalar">
                        <ul class="pagination justify-content-center mt-4">
                            <li class="page-item @(Model.Sayfa == 1 ? "disabled" : "")">
                                <a class="page-link" href="@SayfaAdresi(Model.Sayfa - 1)">Önceki</a>
                            </li>
                            @for (int i = 1; i <= Model.ToplamSayfa; i++)
                            {
                                <li class="page-item @(i == Model.Sayfa ? "active" : "")">
                                    <a class="page-link" href="@SayfaAdresi(i)">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.Sayfa == Model.ToplamSayfa ? "disabled" : "")">
                                <a class="page-link" href="@SayfaAdresi(Model.Sayfa + 1)">Sonraki</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </section>
    </div>
</div>

@section Scripts {
    <script>
        // Sıralama değişince filtrelerle birlikte hemen uygula
        document.getElementById('f-sirala').addEventListener('change', function () {
            document.getElementById('f-siralama-gizli').value = this.value;
            document.getElementById('filtre-form').submit();
        });
    </script>
}
