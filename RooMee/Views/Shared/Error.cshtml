@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center py-4">
    <h1 class="h3 text-danger">Bir hata oluştu</h1>
    <p class="text-muted">İsteğin işlenirken beklenmeyen bir sorun çıktı. Lütfen tekrar dene.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Hata kodu: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana sayfaya dön</a>
</div>
