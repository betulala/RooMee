@model List<KayitliAramaOzetViewModel>
@{
    ViewData["Title"] = "Kayıtlı aramalarım";
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

<div class="sayfa-ust">
    <span class="ust-etiket">Hesabım</span>
    <h1>Kayıtlı aramalarım</h1>
    <p>Kaydettiğin aramalara uyan yeni bir ilan eklenince sana e-posta ile haber veririz.</p>
</div>

@if (!Model.Any())
{
    <div class="bos-durum">
        Henüz kayıtlı araman yok.<br />
        İlanlar sayfasında filtreleri seçip <strong>🔔 Bu aramayı kaydet</strong> butonuna basabilirsin.<br />
        <a asp-controller="Ilan" asp-action="Index" class="ea-btn ea-btn-ana">İlanlara git</a>
    </div>
}
else
{
    <div class="satir-liste">
        @foreach (var o in Model)
        {
            var a = o.Arama;
            <div class="satir-kart">
                <div class="govde">
                    <a asp-action="Ac" asp-route-id="@a.Id" class="baslik">@a.Ad</a>
                    @if (o.Yeni > 0)
                    {
                        <span class="badge rounded-pill ms-1" style="background:var(--rm-accent)">@o.Yeni yeni</span>
                    }
                    <div class="small text-muted mb-2">@a.Kriter.Ozet()</div>
                    <div class="etiketler mb-0">
                        <span class="etiket">@o.Toplam ilan</span>
                        <span class="etiket @(a.EpostaUyarisi ? "dolu" : "")">@(a.EpostaUyarisi ? "🔔 E-posta uyarısı açık" : "🔕 E-posta uyarısı kapalı")</span>
                        <span class="etiket">@a.OlusturmaTarihi.ToLocalTime().ToString("d MMMM yyyy", tr)</span>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Ac" asp-route-id="@a.Id" class="btn btn-sm btn-primary">Sonuçları gör</a>
                    <form asp-action="Uyari" asp-route-id="@a.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(a.EpostaUyarisi ? "Uyarıyı kapat" : "Uyarıyı aç")</button>
                    </form>
                    <form asp-action="Sil" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Bu kayıtlı arama silinsin mi?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
