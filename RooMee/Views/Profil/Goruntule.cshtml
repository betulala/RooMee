@model ApplicationUser
@{
    ViewData["Title"] = Model.KisaAd;
    var p = Model.Profil;
    bool kendi = ViewBag.KendiProfili == true;
    var uyum = ViewBag.Uyum as RooMee.Services.UyumSonucu;
    var degerlendirmeler = ViewBag.Degerlendirmeler as List<Degerlendirme> ?? new();
    var benimki = ViewBag.BenimDegerlendirmem as Degerlendirme;
    bool degerlendirebilir = ViewBag.Degerlendirebilir == true;
    var tr = new System.Globalization.CultureInfo("tr-TR");
}
@functions {
    string Butce(Profil p) => (p.ButceMin, p.ButceMax) switch
    {
        (null, null) => "Belirtilmemiş",
        (int min, null) => $"{min:N0} ₺ ve üzeri",
        (null, int max) => $"{max:N0} ₺'ye kadar",
        (int min, int max) when min == max => $"{min:N0} ₺",
        (int min, int max) => $"{min:N0} – {max:N0} ₺"
    };
    string Saat(TimeOnly? s) => s?.ToString("HH:mm") ?? "–";
    string DurumSinifi(string durum) => durum switch { "Uyumlu" => "ok", "Kısmen" => "mid", _ => "low" };
}

<div class="ea">
    @if (TempData["Mesaj"] is string mesaj)
    {
        <div class="alert alert-success">@mesaj</div>
    }

    <div class="row g-4 justify-content-center">
        <!-- Sol: profil bilgileri -->
        <div class="col-lg-7">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <partial name="~/Views/Kullanici/_Avatar.cshtml" model="Model" view-data='new ViewDataDictionary(ViewData) { ["Buyuk"] = true }' />
                        <div>
                            <h1 class="h4 mb-1">@Model.KisaAd</h1>
                            @if (Model.OgrenciDogrulandi)
                            {
                                <span class="badge bg-success">✓ Doğrulanmış öğrenci</span>
                            }
                            else if (kendi)
                            {
                                <a asp-action="OgrenciDogrula" class="btn btn-sm btn-outline-success">Öğrenciliğini doğrula</a>
                            }
                            else if (p?.Ogrenci == true)
                            {
                                <span class="badge text-bg-light border">Doğrulama bekleniyor</span>
                            }
                        </div>
                    </div>

                    @if (p == null)
                    {
                        <p class="mb-0">
                            @if (kendi)
                            {
                                <span>Profilin henüz boş. <a asp-action="Duzenle">Şimdi doldur</a></span>
                            }
                            else
                            {
                                <span>Bu kullanıcı henüz profilini doldurmamış.</span>
                            }
                        </p>
                    }
                    else
                    {
                        @if (!string.IsNullOrWhiteSpace(p.Hakkinda))
                        {
                            <p style="white-space:pre-line">@p.Hakkinda</p>
                        }
                        <partial name="~/Views/Kullanici/_Etiketler.cshtml" model="Model" />
                    }

                    <div class="d-flex flex-wrap gap-2">
                        @if (kendi)
                        {
                            <a asp-action="Duzenle" class="btn btn-primary">Profili düzenle</a>
                            @if (p?.AramaTuru == null)
                            {
                                <span class="small text-muted align-self-center">Profilin "Ev Arkadaşları" listesinde görünmüyor. Düzenle'den açabilirsin.</span>
                            }
                        }
                        else
                        {
                            <a asp-controller="Mesaj" asp-action="Yeni" asp-route-kullaniciId="@Model.Id" class="btn btn-primary">✉ Mesaj gönder</a>
                            <a asp-controller="Kullanici" asp-action="Index" class="btn btn-outline-secondary">← Ev arkadaşlarına dön</a>
                        }
                    </div>
                </div>
            </div>

            @if (p != null)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h2 class="h6">Kişisel bilgiler</h2>
                        <table class="table table-sm mb-0">
                            <tbody>
                                @if (p.Sehir != null)
                                {
                                    <tr><td class="text-muted w-50">Şehir / İlçe</td><td>@p.Sehir@(p.Ilce != null ? " · " + p.Ilce : "")</td></tr>
                                }
                                @if (p.Yas.HasValue) { <tr><td class="text-muted">Yaş</td><td>@p.Yas</td></tr> }
                                @if (p.Cinsiyet.HasValue) { <tr><td class="text-muted">Cinsiyet</td><td>@p.Cinsiyet.Value.GorunenAd()</td></tr> }
                                @if (p.Ogrenci || p.Calisiyor)
                                {
                                    <tr><td class="text-muted">Statü</td><td>@string.Join(" ve ", new[] { p.Ogrenci ? "Öğrenci" : null, p.Calisiyor ? "Çalışan" : null }.Where(x => x != null))</td></tr>
                                }
                                @if (p.Universite != null) { <tr><td class="text-muted">Üniversite</td><td>@p.Universite</td></tr> }
                                @if (p.Bolum != null) { <tr><td class="text-muted">Bölüm</td><td>@p.Bolum@(p.Sinif != null ? $" ({p.Sinif})" : "")</td></tr> }
                                @if (p.Meslek != null) { <tr><td class="text-muted">@(p.Ogrenci ? "Çalışma durumu" : "Meslek")</td><td>@p.Meslek</td></tr> }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h2 class="h6">Yaşam tercihleri</h2>
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><td class="text-muted w-50">Uyku düzeni</td><td>@(p.Uyku?.GorunenAd() ?? "Belirtilmemiş")</td></tr>
                                @if (p.YatisSaati.HasValue || p.KalkisSaati.HasValue)
                                {
                                    <tr><td class="text-muted">Yatış – kalkış</td><td>@Saat(p.YatisSaati) – @Saat(p.KalkisSaati)</td></tr>
                                }
                                <tr><td class="text-muted">Ders / çalışma düzeni</td><td>@(p.CalismaDuzeni?.GorunenAd() ?? "Belirtilmemiş")</td></tr>
                                <tr><td class="text-muted">Evcil hayvan</td><td>@(p.EvcilHayvan?.GorunenAd() ?? "Belirtilmemiş")</td></tr>
                                <tr><td class="text-muted">Sigara</td><td>@(p.SigaraIciyor ? "İçer" : "İçmez")</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h2 class="h6">Oda ve bütçe</h2>
                        <table class="table table-sm mb-0">
                            <tbody>
                                @if (p.AramaTuru.HasValue) { <tr><td class="text-muted w-50">İlan türü</td><td>@p.AramaTuru.Value.GorunenAd()</td></tr> }
                                @if (p.TercihOdaTipi.HasValue) { <tr><td class="text-muted">Oda tipi</td><td>@p.TercihOdaTipi.Value.GorunenAd()</td></tr> }
                                @if (p.AramaTuru == AramaTuru.KiralikEv && (p.EvTipi != null || p.BosOda != null))
                                {
                                    <tr><td class="text-muted">Ev / boş oda</td><td>@p.EvTipi@(p.BosOda != null ? $" · {p.BosOda} boş oda" : "")</td></tr>
                                }
                                <tr><td class="text-muted">Aylık bütçe</td><td>@Butce(p)</td></tr>
                                <tr><td class="text-muted">Son güncelleme</td><td>@p.GuncellemeTarihi.ToLocalTime().ToString("d MMMM yyyy", tr)</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                @if (p.HobiListesi.Any())
                {
                    <div class="card shadow-sm mb-3">
                        <div class="card-body">
                            <h2 class="h6">Hobiler &amp; ilgi alanları</h2>
                            <div class="etiketler mb-0">
                                @foreach (var h in p.HobiListesi) { <span class="etiket">@h</span> }
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- Değerlendirmeler -->
            <div class="card shadow-sm mb-3" id="degerlendirmeler">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                        <h2 class="h6 mb-0">Değerlendirmeler</h2>
                        @if (degerlendirmeler.Any())
                        {
                            <span>
                                <partial name="~/Views/Kullanici/_Yildizlar.cshtml" model="degerlendirmeler.Average(d => d.Puan)" />
                                <span class="puan-ozet">@degerlendirmeler.Average(d => d.Puan).ToString("0.0", tr) · @degerlendirmeler.Count değerlendirme</span>
                            </span>
                        }
                    </div>

                    @if (!degerlendirmeler.Any())
                    {
                        <p class="small text-muted mb-0">Henüz değerlendirme yok.</p>
                    }
                    @foreach (var d in degerlendirmeler)
                    {
                        <div class="yorum">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold small">@d.Yazan?.KisaAd</span>
                                <small class="text-muted">@d.Tarih.ToLocalTime().ToString("d MMMM yyyy", tr)</small>
                            </div>
                            <partial name="~/Views/Kullanici/_Yildizlar.cshtml" model="(double)d.Puan" />
                            @if (!string.IsNullOrWhiteSpace(d.Yorum))
                            {
                                <p class="small mb-0 mt-1" style="white-space:pre-line">@d.Yorum</p>
                            }
                        </div>
                    }

                    @if (degerlendirebilir)
                    {
                        <form asp-controller="Degerlendirme" asp-action="Kaydet" method="post" class="mt-3 pt-3 border-top">
                            <input type="hidden" name="hakkindaId" value="@Model.Id" />
                            <div class="small fw-semibold mb-1">@(benimki == null ? "Değerlendir" : "Değerlendirmeni güncelle")</div>
                            <div class="yildiz-sec mb-2" role="radiogroup" aria-label="Puan">
                                @for (int i = 5; i >= 1; i--)
                                {
                                    <input type="radio" name="puan" id="puan-@i" value="@i" checked="@(benimki?.Puan == i)" required />
                                    <label for="puan-@i" title="@i yıldız">★</label>
                                }
                            </div>
                            <textarea name="yorum" class="form-control mb-2" rows="2" maxlength="500"
                                      placeholder="Ev arkadaşı olarak nasıldı? (isteğe bağlı)">@benimki?.Yorum</textarea>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-sm btn-primary">Kaydet</button>
                                @if (benimki != null)
                                {
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            formaction="@Url.Action("Sil", "Degerlendirme", new { hakkindaId = Model.Id })" formnovalidate>Sil</button>
                                }
                            </div>
                        </form>
                    }
                    else if (!kendi && User.Identity?.IsAuthenticated == true)
                    {
                        <p class="small text-muted mt-3 mb-0">Karşılıklı mesajlaştığın kişileri değerlendirebilirsin.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Sağ: uyum ve hesap -->
        <div class="col-lg-4">
            @if (!kendi && p != null)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        @if (p.Butce.HasValue)
                        {
                            <div class="fiyat mb-1" style="font-size:1.3rem">@p.Butce.Value.ToString("N0", tr)₺<span style="font-size:.85rem"> / ay</span></div>
                        }
                        @if (uyum != null)
                        {
                            <div class="uyum d-inline-block mb-2">%@uyum.Skor uyum skoru</div>
                            <ul class="uyum-listesi">
                                @foreach (var s in uyum.Satirlar)
                                {
                                    <li>
                                        <span>@s.Ad@if (s.Not != null) {<small>@s.Not</small>}</span>
                                        <span class="durum @DurumSinifi(s.Durum)">@s.Durum</span>
                                    </li>
                                }
                            </ul>
                            <p class="small text-muted mt-2 mb-0">Uyum, senin profilindeki tercihlerine göre hesaplanır. E-posta adresleri gizlidir.</p>
                        }
                        else
                        {
                            <p class="small text-muted mb-0">
                                Uyum skorunu görmek için <a asp-action="Duzenle">profilindeki yaşam tercihlerini</a> doldur.
                            </p>
                        }
                    </div>
                </div>
                <div class="card shadow-sm mb-3">
                    <div class="card-body">
                        <h2 class="h6">Güvenlik hatırlatması</h2>
                        <p class="small">
                            Kapora veya önden ödeme isteyen kişileri bildir. Görüşmeden önce karşı tarafın
                            doğrulama rozetini kontrol et, kişisel ve finansal bilgilerini paylaşma.
                        </p>
                        <a asp-controller="Sikayet" asp-action="Olustur" asp-route-kullaniciId="@Model.Id" class="btn btn-sm btn-outline-danger">⚑ Bu kullanıcıyı şikayet et</a>
                    </div>
                </div>
            }

            @if (kendi)
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h6 mb-3">Hesap ayarları</h2>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-sm btn-outline-secondary">Şifre ve hesap ayarları</a>
                            <a asp-action="HesapSil" class="btn btn-sm btn-outline-danger">Hesabımı sil</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
