@model ProfilDuzenleViewModel
@{
    ViewData["Title"] = "Profili Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-4">Profili Düzenle</h1>

        <form asp-action="Duzenle" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="d-flex align-items-center gap-3 mb-4">
                @if (!string.IsNullOrEmpty(Model.MevcutFotoYolu))
                {
                    <img src="@Model.MevcutFotoYolu" alt="" class="rounded-circle"
                         style="width:80px;height:80px;object-fit:cover" />
                }
                <div class="flex-grow-1">
                    <label asp-for="Foto" class="form-label"></label>
                    <input asp-for="Foto" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">JPG, PNG veya WEBP · en fazla 2 MB</div>
                    <span asp-validation-for="Foto" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Ad" class="form-label"></label>
                    <input asp-for="Ad" class="form-control" />
                    <span asp-validation-for="Ad" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Soyad" class="form-label"></label>
                    <input asp-for="Soyad" class="form-control" />
                    <span asp-validation-for="Soyad" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Universite" class="form-label"></label>
                    <input asp-for="Universite" class="form-control" placeholder="Selçuk Üniversitesi" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Bolum" class="form-label"></label>
                    <input asp-for="Bolum" class="form-control" placeholder="Bilgisayar Mühendisliği" />
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="ButceMin" class="form-label"></label>
                    <input asp-for="ButceMin" class="form-control" placeholder="4000" />
                    <span asp-validation-for="ButceMin" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="ButceMax" class="form-label"></label>
                    <input asp-for="ButceMax" class="form-control" placeholder="6000" />
                    <span asp-validation-for="ButceMax" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="YatisSaati" class="form-label"></label>
                    <input asp-for="YatisSaati" type="time" class="form-control" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="KalkisSaati" class="form-label"></label>
                    <input asp-for="KalkisSaati" type="time" class="form-control" />
                </div>
            </div>

            <label class="form-label">Yaşam tarzı</label>
            <div class="mb-3">
                <div class="form-check form-switch">
                    <input asp-for="SigaraIciyor" class="form-check-input" />
                    <label asp-for="SigaraIciyor" class="form-check-label"></label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="EvcilHayvanVar" class="form-check-input" />
                    <label asp-for="EvcilHayvanVar" class="form-check-label"></label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="SessizOrtamIster" class="form-check-input" />
                    <label asp-for="SessizOrtamIster" class="form-check-label"></label>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Hakkinda" class="form-label"></label>
                <textarea asp-for="Hakkinda" class="form-control" rows="4" placeholder="Kendini kısaca tanıt…"></textarea>
                <span asp-validation-for="Hakkinda" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Goruntule" class="btn btn-outline-secondary">İptal</a>
            </div>
        </form>

        <hr />
        <p class="small mb-0">
            <a asp-area="Identity" asp-page="/Account/Manage/Index">Şifre ve hesap ayarları</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}