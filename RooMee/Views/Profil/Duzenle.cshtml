@model ProfilDuzenleViewModel
@{
    ViewData["Title"] = "Profili Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-4">Profili Düzenle</h1>

        <form asp-action="Duzenle" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="d-flex align-items-center gap-3 mb-4">
                @if (!string.IsNullOrEmpty(Model.MevcutFotoYolu))
                {
                    <img src="@Model.MevcutFotoYolu" alt="" class="rounded-circle"
                         style="width:80px;height:80px;object-fit:cover" />
                }
                <div class="flex-grow-1">
                    <label asp-for="Foto" class="form-label"></label>
                    <input asp-for="Foto" type="file" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">JPG, PNG veya WEBP · en fazla 2 MB</div>
                    <span asp-validation-for="Foto" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Ad" class="form-label"></label>
                    <input asp-for="Ad" class="form-control" />
                    <span asp-validation-for="Ad" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Soyad" class="form-label"></label>
                    <input asp-for="Soyad" class="form-control" />
                    <span asp-validation-for="Soyad" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Universite" class="form-label"></label>
                    <input asp-for="Universite" class="form-control" placeholder="Selçuk Üniversitesi" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Bolum" class="form-label"></label>
                    <input asp-for="Bolum" class="form-control" placeholder="Bilgisayar Mühendisliği" />
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="ButceMin" class="form-label"></label>
                    <input asp-for="ButceMin" class="form-control" placeholder="4000" />
                    <span asp-validation-for="ButceMin" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="ButceMax" class="form-label"></label>
                    <input asp-for="ButceMax" class="form-control" placeholder="6000" />
                    <span asp-validation-for="ButceMax" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="YatisSaati" class="form-label"></label>
                    <input asp-for="YatisSaati" type="time" class="form-control" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="KalkisSaati" class="form-label"></label>
                    <input asp-for="KalkisSaati" type="time" class="form-control" />
                </div>
            </div>

            <h2 class="h6 mt-4 mb-3 border-bottom pb-2">Kişisel bilgiler</h2>
            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Cinsiyet" class="form-label"></label>
                    <select asp-for="Cinsiyet" asp-items="Html.GetEnumSelectList<Cinsiyet>()" class="form-select">
                        <option value="">Belirtmek istemiyorum</option>
                    </select>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="DogumYili" class="form-label"></label>
                    <input asp-for="DogumYili" class="form-control" placeholder="2003" />
                    <span asp-validation-for="DogumYili" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Sehir" class="form-label"></label>
                    <input asp-for="Sehir" class="form-control" placeholder="Konya" />
                    <span asp-validation-for="Sehir" class="text-danger"></span>
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Ilce" class="form-label"></label>
                    <input asp-for="Ilce" class="form-control" placeholder="Selçuklu" />
                </div>
            </div>
            <div class="mb-2">
                <div class="form-check form-check-inline">
                    <input asp-for="Ogrenci" class="form-check-input" />
                    <label asp-for="Ogrenci" class="form-check-label"></label>
                </div>
                <div class="form-check form-check-inline">
                    <input asp-for="Calisiyor" class="form-check-input" />
                    <label asp-for="Calisiyor" class="form-check-label"></label>
                </div>
            </div>
            <div class="row">
                <div class="col-6 mb-3">
                    <label asp-for="Sinif" class="form-label"></label>
                    <input asp-for="Sinif" class="form-control" placeholder="3. sınıf" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="Meslek" class="form-label"></label>
                    <input asp-for="Meslek" class="form-control" placeholder="Hemşire, yazılımcı…" />
                </div>
            </div>

            <h2 class="h6 mt-4 mb-3 border-bottom pb-2">Yaşam tercihleri</h2>
            <div class="row">
                <div class="col-sm-4 mb-3">
                    <label asp-for="Uyku" class="form-label"></label>
                    <select asp-for="Uyku" asp-items="Html.GetEnumSelectList<UykuDuzeni>()" class="form-select">
                        <option value="">Seç</option>
                    </select>
                </div>
                <div class="col-sm-4 mb-3">
                    <label asp-for="CalismaDuzeni" class="form-label"></label>
                    <select asp-for="CalismaDuzeni" asp-items="Html.GetEnumSelectList<CalismaDuzeni>()" class="form-select">
                        <option value="">Seç</option>
                    </select>
                </div>
                <div class="col-sm-4 mb-3">
                    <label asp-for="EvcilHayvan" class="form-label"></label>
                    <select asp-for="EvcilHayvan" asp-items="Html.GetEnumSelectList<EvcilHayvanDurumu>()" class="form-select">
                        <option value="">Seç</option>
                    </select>
                </div>
            </div>
            <div class="form-check form-switch mb-3">
                <input asp-for="SigaraIciyor" class="form-check-input" />
                <label asp-for="SigaraIciyor" class="form-check-label"></label>
            </div>
            <label class="form-label">Hobiler</label>
            <div class="mb-3">
                @foreach (var h in Hobiler.Liste)
                {
                    var id = "hobi-" + Array.IndexOf(Hobiler.Liste, h);
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" name="Hobiler" value="@h" id="@id" checked="@Model.Hobiler.Contains(h)" />
                        <label class="form-check-label" for="@id">@h</label>
                    </div>
                }
            </div>

            <h2 class="h6 mt-4 mb-3 border-bottom pb-2">Ev arkadaşları listesi</h2>
            <div class="mb-3">
                <label asp-for="AramaTuru" class="form-label"></label>
                <select asp-for="AramaTuru" asp-items="Html.GetEnumSelectList<AramaTuru>()" class="form-select" id="arama-turu">
                    <option value="">Listede görünme</option>
                </select>
                <div class="form-text">Seçersen profilin "Ev Arkadaşları" sayfasında listelenir. E-posta adresin hiçbir zaman gösterilmez.</div>
            </div>
            <div class="mb-3">
                <label asp-for="TercihOdaTipi" class="form-label"></label>
                <select asp-for="TercihOdaTipi" asp-items="Html.GetEnumSelectList<TercihOdaTipi>()" class="form-select">
                    <option value="">Fark etmez</option>
                </select>
            </div>
            <div class="row" id="ev-bilgisi">
                <div class="col-6 mb-3">
                    <label asp-for="EvTipi" class="form-label"></label>
                    <input asp-for="EvTipi" class="form-control" placeholder="2+1" />
                </div>
                <div class="col-6 mb-3">
                    <label asp-for="BosOda" class="form-label"></label>
                    <input asp-for="BosOda" class="form-control" placeholder="1" />
                    <span asp-validation-for="BosOda" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Hakkinda" class="form-label"></label>
                <textarea asp-for="Hakkinda" class="form-control" rows="4" placeholder="Kendini kısaca tanıt…"></textarea>
                <span asp-validation-for="Hakkinda" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Kaydet</button>
                <a asp-action="Goruntule" class="btn btn-outline-secondary">İptal</a>
            </div>
        </form>

        <hr />
        <p class="small mb-0">
            <a asp-area="Identity" asp-page="/Account/Manage/Index">Şifre ve hesap ayarları</a>
            · <a asp-action="HesapSil" class="text-danger">Hesabımı sil</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Ev tipi ve boş oda alanları sadece "Kiralık ev ilanı" seçiliyse görünsün
        const tur = document.getElementById('arama-turu');
        const ev = document.getElementById('ev-bilgisi');
        const guncelle = () => ev.style.display = tur.value === '@((int)AramaTuru.KiralikEv)' ? '' : 'none';
        tur.addEventListener('change', guncelle);
        guncelle();
    </script>
}