@model List<Favori>
@{
    ViewData["Title"] = "Favorilerim";
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

<div class="sayfa-ust">
    <span class="ust-etiket">Hesabım</span>
    <h1>Favorilerim</h1>
    <p>Beğendiğin ilanlar burada; rahatça karşılaştırabilirsin.</p>
</div>

@if (!Model.Any())
{
    <div class="bos-durum">
        Henüz favori ilanın yok.<br />
        <a asp-controller="Ilan" asp-action="Index" class="ea-btn ea-btn-ana">İlanlara göz at</a>
    </div>
}
else
{
    <div class="satir-liste">
        @foreach (var fav in Model)
        {
            var ilan = fav.Ilan!;
            var kapak = ilan.Fotolar.FirstOrDefault()?.Yol;

            <div class="satir-kart @(ilan.Aktif ? "" : "opacity-75")">
                @if (kapak != null)
                {
                    <img src="@kapak" alt="" class="kucuk-foto" />
                }
                else
                {
                    <div class="kucuk-foto">Fotoğraf yok</div>
                }

                <div class="govde">
                    @if (ilan.Aktif)
                    {
                        <a asp-controller="Ilan" asp-action="Detay" asp-route-id="@ilan.Id" class="baslik">@ilan.Baslik</a>
                    }
                    else
                    {
                        <span class="baslik">@ilan.Baslik</span>
                    }
                    <div class="small text-muted mb-2">@ilan.Ilce · @ilan.Sehir · @ilan.Kullanici?.KisaAd</div>
                    <div class="etiketler mb-0">
                        <span class="etiket dolu">@ilan.OdaTipi.GorunenAd()</span>
                        @if (ilan.Kullanici?.OgrenciDogrulandi == true) { <span class="etiket vurgu">Doğrulanmış öğrenci</span> }
                        @if (!ilan.Aktif) { <span class="etiket vurgu">Yayından kaldırılmış</span> }
                    </div>
                </div>

                <div class="text-end">
                    <div class="fiyat mb-2">@ilan.Kira.ToString("N0", tr)₺<span> / ay</span></div>
                    <form asp-action="Degistir" method="post">
                        <input type="hidden" name="ilanId" value="@ilan.Id" />
                        <input type="hidden" name="returnUrl" value="/Favori" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">♥ Favoriden çıkar</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
