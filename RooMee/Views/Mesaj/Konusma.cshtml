@model Konusma
@{
    string benimId = ViewBag.BenimId;
    var karsi = Model.KarsiTaraf(benimId);
    ViewData["Title"] = karsi?.KisaAd ?? "Mesajlar";
    DateTime? oncekiGun = null;
}
@functions {
    string GunBasligi(DateTime gun)
    {
        if (gun == DateTime.Today) return "Bugün";
        if (gun == DateTime.Today.AddDays(-1)) return "Dün";
        return gun.ToString("d MMMM yyyy");
    }
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <!-- Üst bilgi -->
            <div class="card-header bg-white d-flex align-items-center gap-3">
                <a asp-action="Index" class="btn btn-sm btn-link text-decoration-none px-0" title="Mesajlarım">←</a>
                <partial name="_Avatar" model="karsi" view-data='new ViewDataDictionary(ViewData) { ["Boyut"] = 40 }' />
                <div class="flex-grow-1">
                    @if (karsi != null)
                    {
                        <a asp-controller="Profil" asp-action="Goruntule" asp-route-id="@karsi.Id" class="fw-semibold text-decoration-none">@karsi.KisaAd</a>
                        @if (karsi.OgrenciDogrulandi)
                        {
                            <span class="badge bg-success ms-1">✓ Öğrenci</span>
                        }
                    }
                    @if (Model.Ilan != null)
                    {
                        <div class="small text-muted">
                            İlan: <a asp-controller="Ilan" asp-action="Detay" asp-route-id="@Model.Ilan.Id">@Model.Ilan.Baslik</a>
                        </div>
                    }
                </div>
            </div>

            <!-- Mesajlar -->
            <div id="mesajlar" class="card-body bg-light" style="height:60vh;overflow-y:auto">
                @if (!Model.Mesajlar.Any())
                {
                    <p id="bos-mesaj" class="text-center text-muted small my-5">Henüz mesaj yok. İlk mesajı sen gönder!</p>
                }
                @foreach (var m in Model.Mesajlar)
                {
                    var yerel = m.Tarih.ToLocalTime();
                    if (oncekiGun != yerel.Date)
                    {
                        oncekiGun = yerel.Date;
                        <div class="text-center my-2" data-gun-basligi="@yerel.ToString("yyyy-MM-dd")"><span class="badge text-bg-secondary fw-normal">@GunBasligi(yerel.Date)</span></div>
                    }
                    <partial name="_MesajBalonu" model="m" view-data='new ViewDataDictionary(ViewData) { ["BenimId"] = benimId }' />
                }
            </div>

            <!-- Gönderme kutusu -->
            <div class="card-footer bg-white">
                <form asp-action="Gonder" method="post" class="d-flex gap-2" id="gonder-form">
                    <input type="hidden" name="konusmaId" value="@Model.Id" />
                    <textarea name="metin" id="metin" class="form-control" rows="1" maxlength="1000" required
                              placeholder="Mesaj yaz..." style="resize:none"></textarea>
                    <button type="submit" class="btn btn-primary">Gönder</button>
                </form>
                <div class="small text-muted mt-1">Enter: gönder · Shift+Enter: yeni satır</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // En son mesaja kaydır
        const kutu = document.getElementById('mesajlar');
        kutu.scrollTop = kutu.scrollHeight;

        // Enter ile gönder, Shift+Enter ile alt satır
        const metin = document.getElementById('metin');
        metin.focus();
        metin.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                if (metin.value.trim()) metin.form.requestSubmit();
            }
        });

        // ---- Sayfayı yenilemeden mesajlaşma ----
        const konusmaId = @Model.Id;
        const yenilerAdresi = '@Url.Action("Yeniler", new { konusmaId = Model.Id })';
        const form = document.getElementById('gonder-form');
        let bekliyor = false;

        const sonId = () => {
            const balonlar = kutu.querySelectorAll('[data-mesaj-id]');
            return balonlar.length ? Number(balonlar[balonlar.length - 1].dataset.mesajId) : 0;
        };
        const enAltta = () => kutu.scrollHeight - kutu.scrollTop - kutu.clientHeight < 80;

        async function yenile() {
            if (bekliyor) return;
            bekliyor = true;
            try {
                const cevap = await fetch(`${yenilerAdresi}&sonId=${sonId()}`, { headers: { 'X-Requested-With': 'fetch' } });
                if (!cevap.ok) return;
                const veri = {
                    html: (await cevap.text()).trim(),
                    okunanlar: (cevap.headers.get('X-Okunanlar') || '').split(',').filter(Boolean)
                };
                const alttaydi = enAltta();

                if (veri.html) {
                    document.getElementById('bos-mesaj')?.remove();
                    const gecici = document.createElement('div');
                    gecici.innerHTML = veri.html;
                    for (const balon of [...gecici.children]) {
                        // Aynı mesaj iki kez eklenmesin
                        if (kutu.querySelector(`[data-mesaj-id="${balon.dataset.mesajId}"]`)) continue;
                        // Yeni güne geçildiyse "Bugün" başlığı ekle
                        const gun = balon.dataset.gun;
                        if (gun && !kutu.querySelector(`[data-gun-basligi="${gun}"]`)) {
                            const baslik = document.createElement('div');
                            baslik.className = 'text-center my-2';
                            baslik.dataset.gunBasligi = gun;
                            baslik.innerHTML = '<span class="badge text-bg-secondary fw-normal">Bugün</span>';
                            kutu.appendChild(baslik);
                        }
                        kutu.appendChild(balon);
                    }
                    if (alttaydi) kutu.scrollTop = kutu.scrollHeight;
                }
                // Karşı tarafın okuduğu mesajlarımı ✓✓ yap
                for (const id of veri.okunanlar || []) {
                    const isaret = kutu.querySelector(`[data-mesaj-id="${id}"] .okundu-isareti`);
                    if (isaret) { isaret.textContent = '✓✓'; isaret.title = 'Okundu'; }
                }
            } catch { /* bağlantı koptuysa bir sonraki denemede tekrar dener */ }
            finally { bekliyor = false; }
        }

        // Gönder: sayfa yenilenmeden gönder, sonra yeni mesajları çek
        form.addEventListener('submit', async e => {
            e.preventDefault();
            const yazi = metin.value.trim();
            if (!yazi) return;
            const veri = new FormData(form);
            metin.value = '';
            metin.focus();
            try {
                await fetch(form.action, { method: 'POST', body: veri });
            } catch {
                metin.value = yazi; // gönderilemediyse yazıyı geri koy
                return;
            }
            await yenile();
            kutu.scrollTop = kutu.scrollHeight;
        });

        // Sekme açıkken 4 saniyede bir yeni mesaj var mı bak
        setInterval(() => { if (!document.hidden) yenile(); }, 4000);
        document.addEventListener('visibilitychange', () => { if (!document.hidden) yenile(); });
    </script>
}
