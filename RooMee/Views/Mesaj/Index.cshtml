@model List<KonusmaOzetViewModel>
@{
    ViewData["Title"] = "Mesajlarım";
    string benimId = ViewBag.BenimId;
}
@functions {
    string Zaman(DateTime utc)
    {
        var t = utc.ToLocalTime();
        if (t.Date == DateTime.Today) return t.ToString("HH:mm");
        if (t.Date == DateTime.Today.AddDays(-1)) return "Dün";
        return t.ToString("dd.MM.yyyy");
    }
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sayfa-ust">
            <span class="ust-etiket">Hesabım</span>
            <h1>Mesajlarım</h1>
            <p>Ev arkadaşı adaylarınla yaptığın konuşmalar.</p>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                Henüz mesajın yok.<br />
                Beğendiğin bir ilanda <strong>İletişime geç</strong> butonuna basarak ilk mesajını gönderebilirsin.<br />
                <a asp-controller="Ilan" asp-action="Index" class="btn btn-outline-primary mt-3">İlanlara göz at</a>
            </div>
        }
        else
        {
            <div class="list-group shadow-sm">
                @foreach (var o in Model)
                {
                    var karsi = o.Konusma.KarsiTaraf(benimId);
                    bool benGonderdim = o.SonMesaj.GonderenId == benimId;

                    <a asp-action="Konusma" asp-route-id="@o.Konusma.Id"
                       class="list-group-item list-group-item-action d-flex gap-3 align-items-center py-3">
                        <partial name="_Avatar" model="karsi" />
                        <div class="flex-grow-1 overflow-hidden">
                            <div class="d-flex justify-content-between">
                                <span class="@(o.Okunmamis > 0 ? "fw-bold" : "fw-semibold")">@karsi?.KisaAd</span>
                                <small class="text-muted">@Zaman(o.SonMesaj.Tarih)</small>
                            </div>
                            @if (o.Konusma.Ilan != null)
                            {
                                <div class="small text-muted text-truncate">İlan: @o.Konusma.Ilan.Baslik</div>
                            }
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-truncate @(o.Okunmamis > 0 ? "fw-semibold" : "text-muted")">
                                    @(benGonderdim ? "Sen: " : "")@o.SonMesaj.Metin
                                </span>
                                @if (o.Okunmamis > 0)
                                {
                                    <span class="badge rounded-pill bg-primary ms-2">@o.Okunmamis</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>
