@model List<Ilan>
@{
    ViewData["Title"] = "Ana Sayfa";
    var sehirler = ViewBag.Sehirler as List<string> ?? new();
}

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

<!-- Karşılama ve arama -->
<section class="karsilama">
    <span class="ust-etiket">Öğrenciler için ev arkadaşı platformu</span>
    <h1>Kendine uygun ev arkadaşını <span>güvenle</span> bul.</h1>
    <p>
        Öğrenciler için oda ve ev arkadaşı ilanları. Doğrulanmış öğrencilerle,
        yaşam tarzına uygun kişilerle eşleş.
    </p>

    <form asp-controller="Ilan" asp-action="Index" method="get"
          class="d-flex flex-column flex-sm-row gap-2 mx-auto" style="max-width:560px">
        <input class="form-control form-control-lg" name="Sehir" list="anaSehirListesi"
               placeholder="Hangi şehirde arıyorsun?" aria-label="Şehir" />
        <datalist id="anaSehirListesi">
            @foreach (var s in sehirler)
            {
                <option value="@s"></option>
            }
        </datalist>
        <button type="submit" class="ea-btn ea-btn-ana text-nowrap">🔍 İlan ara</button>
    </form>

    <div class="d-flex flex-wrap justify-content-center gap-2 mt-3">
        <a asp-controller="Kullanici" asp-action="Index" class="ea-btn ea-btn-sade ea-btn-kucuk">Ev arkadaşlarına göz at</a>
        <a asp-controller="Ilan" asp-action="Olustur" class="ea-btn ea-btn-sade ea-btn-kucuk">Odan mı var? Ücretsiz ilan ver</a>
    </div>
</section>

<!-- Nasıl çalışır (giriş yapmamış ziyaretçiler için; giriş yapanlar yerine kişisel önerileri görür) -->
@if (User.Identity?.IsAuthenticated != true)
{
<section class="bolum pt-0">
    <div class="bolum-baslik">
        <span class="ust-etiket">Nasıl çalışır?</span>
        <h2>3 adımda uyumlu ev arkadaşını bul</h2>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <div class="deger-kart adim-kart h-100">
                <div class="ikon">👤</div>
                <h3>Profilini oluştur</h3>
                <p>Uyku düzenini, bütçeni ve hobilerini ekle; üniversite e-postanla öğrenciliğini doğrula.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="deger-kart adim-kart h-100">
                <div class="ikon">🔍</div>
                <h3>Uyumlu ilanları keşfet</h3>
                <p>Şehir, kira ve yaşam tarzına göre filtrele; her kişiyle uyum yüzdeni gör.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="deger-kart adim-kart h-100">
                <div class="ikon">✉️</div>
                <h3>Güvenle iletişime geç</h3>
                <p>E-posta adresini paylaşmadan site içinden mesajlaş, şüpheli durumları şikayet et.</p>
            </div>
        </div>
    </div>
</section>
}

<!-- Sana özel öneriler (giriş yapan kullanıcı) -->
@if (User.Identity?.IsAuthenticated == true)
{
    var oneriKisiler = ViewBag.OneriKisiler as List<KullaniciKartViewModel> ?? new();
    var oneriIlanlar = ViewBag.OneriIlanlar as List<Ilan> ?? new();
    string? oneriSehir = ViewBag.OneriSehir;
    int? oneriButce = ViewBag.OneriButce;
    var tr = new System.Globalization.CultureInfo("tr-TR");

    <section class="bolum pt-0">
        <div class="mb-3">
            <span class="ust-etiket">Sana özel</span>
            <h2 class="h3 mb-0">Önerilerimiz</h2>
        </div>

        @if (ViewBag.ProfilVar != true)
        {
            <div class="form-kart d-flex flex-wrap align-items-center justify-content-between gap-3">
                <span>Profilindeki yaşam tercihlerini ve bütçeni doldurursan sana en uyumlu ev arkadaşlarını ve ilanları önerebiliriz.</span>
                <a asp-controller="Profil" asp-action="Duzenle" class="ea-btn ea-btn-ana">Profilini doldur</a>
            </div>
        }
        else
        {
            @if (oneriKisiler.Any())
            {
                <div class="d-flex justify-content-between align-items-end mb-2">
                    <h3 class="h6 mb-0">Sana en uyumlu ev arkadaşları</h3>
                    <a asp-controller="Kullanici" asp-action="Index" asp-route-Siralama="uyum" class="small">Hepsini uyuma göre sırala →</a>
                </div>
                <div class="kart-izgara uc mb-4">
                    @foreach (var k in oneriKisiler)
                    {
                        <partial name="~/Views/Kullanici/_KisiKarti.cshtml" model="k" />
                    }
                </div>
            }

            <div class="d-flex justify-content-between align-items-end mb-2">
                <h3 class="h6 mb-0">
                    Sana uygun ilanlar
                    <span class="text-muted fw-normal small">
                        (@(oneriSehir ?? "tüm şehirler")@(oneriButce.HasValue ? $" · {oneriButce.Value.ToString("N0", tr)}₺'ye kadar" : ""))
                    </span>
                </h3>
                <a asp-controller="Ilan" asp-action="Index" asp-route-Sehir="@oneriSehir" asp-route-KiraMax="@oneriButce" class="small">Tümünü gör →</a>
            </div>
            @if (oneriIlanlar.Any())
            {
                <div class="kart-izgara uc">
                    @foreach (var ilan in oneriIlanlar)
                    {
                        <partial name="~/Views/Ilan/_IlanKarti.cshtml" model="ilan" />
                    }
                </div>
            }
            else
            {
                <p class="small text-muted">Şu an şehrinde ve bütçene uygun ilan yok. <a asp-controller="Ilan" asp-action="Index" asp-route-Sehir="@oneriSehir" asp-route-KiraMax="@oneriButce">Aramayı kaydedersen</a> yeni ilan gelince haber veririz.</p>
            }
        }
    </section>
}

<!-- Son ilanlar -->
<section class="bolum pt-0">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <span class="ust-etiket">Yeni eklenenler</span>
            <h2 class="h3 mb-0">Son ilanlar</h2>
        </div>
        <a asp-controller="Ilan" asp-action="Index" class="ea-btn ea-btn-sade ea-btn-kucuk">Tümünü gör →</a>
    </div>

    @if (!Model.Any())
    {
        <div class="bos-durum">
            Henüz ilan yok.<br />
            <a asp-controller="Ilan" asp-action="Olustur" class="ea-btn ea-btn-ana">İlk ilanı sen ver</a>
        </div>
    }
    else
    {
        <div class="kart-izgara uc">
            @foreach (var ilan in Model)
            {
                <partial name="~/Views/Ilan/_IlanKarti.cshtml" model="ilan" />
            }
        </div>
    }
</section>
