@model Ilan
@{
    ViewData["Title"] = Model.Baslik;
    bool sahibi = ViewBag.Sahibi == true;
    bool favoride = ViewBag.Favoride == true;
    var sahip = Model.Kullanici!;
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}
@if (!Model.Aktif)
{
    <div class="alert alert-warning">Bu ilan yayında değil; sadece sen görebiliyorsun.</div>
}

<div class="mb-3">
    <a asp-action="Index" class="small">← İlanlara dön</a>
</div>

<div class="row g-4">
    <!-- Sol: fotoğraflar ve ilan bilgileri -->
    <div class="col-lg-8">
        <div class="card shadow-sm overflow-hidden mb-3">
            @if (Model.Fotolar.Any())
            {
                <div id="ilanFotolari" class="carousel slide">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.Fotolar.Count; i++)
                        {
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@Model.Fotolar[i].Yol" class="d-block w-100"
                                     style="height:400px;object-fit:cover" alt="İlan fotoğrafı @(i + 1)" />
                            </div>
                        }
                    </div>
                    @if (Model.Fotolar.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#ilanFotolari" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span><span class="visually-hidden">Önceki</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#ilanFotolari" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span><span class="visually-hidden">Sonraki</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="ilan-foto" style="height:300px">Fotoğraf yok</div>
            }

            <div class="card-body">
                <span class="ust-etiket">@Model.Ilce · @Model.Sehir</span>
                <h1 class="h3 mt-1 mb-3">@Model.Baslik</h1>
                <div class="etiketler">
                    <span class="etiket dolu">@Model.OdaTipi.GorunenAd()</span>
                    @if (Model.SadeceOgrenci) { <span class="etiket">Öğrenci arıyor</span> }
                    @if (Model.SigaraIcmeyen) { <span class="etiket">Sigara içmeyen</span> }
                    @if (Model.Sessiz) { <span class="etiket">Sessiz</span> }
                    @if (Model.EvcilHayvanKabul) { <span class="etiket">Evcil hayvan kabul</span> }
                    @if (sahip.OgrenciDogrulandi) { <span class="etiket vurgu">Doğrulanmış öğrenci</span> }
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h6">Açıklama</h2>
                <p class="mb-0" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(Model.Aciklama) ? "Açıklama eklenmemiş." : Model.Aciklama)</p>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h6">İlan bilgileri</h2>
                <table class="table table-sm mb-0">
                    <tbody>
                        <tr><td class="text-muted w-50">Şehir / İlçe</td><td>@Model.Sehir · @Model.Ilce</td></tr>
                        <tr><td class="text-muted">Oda tipi</td><td>@Model.OdaTipi.GorunenAd()</td></tr>
                        <tr><td class="text-muted">Aylık kira</td><td>@Model.Kira.ToString("N0", tr) ₺</td></tr>
                        <tr><td class="text-muted">Öğrenci olsun</td><td>@(Model.SadeceOgrenci ? "Evet" : "Fark etmez")</td></tr>
                        <tr><td class="text-muted">Sigara</td><td>@(Model.SigaraIcmeyen ? "İçmeyen biri" : "Fark etmez")</td></tr>
                        <tr><td class="text-muted">Sessiz ortam</td><td>@(Model.Sessiz ? "Evet" : "Fark etmez")</td></tr>
                        <tr><td class="text-muted">Evcil hayvan</td><td>@(Model.EvcilHayvanKabul ? "Kabul ediliyor" : "Kabul edilmiyor")</td></tr>
                        <tr><td class="text-muted">İlan tarihi</td><td>@Model.OlusturmaTarihi.ToLocalTime().ToString("d MMMM yyyy", tr)</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Sağ: fiyat, ilan sahibi ve iletişim -->
    <div class="col-lg-4">
        <div class="yan-kart">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="fiyat mb-3" style="font-size:1.5rem">@Model.Kira.ToString("N0", tr)₺<span style="font-size:.85rem"> / ay</span></div>

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <partial name="~/Views/Kullanici/_Avatar.cshtml" model="sahip" />
                        <div>
                            <div class="small text-muted">İlan sahibi</div>
                            <a asp-controller="Profil" asp-action="Goruntule" asp-route-id="@sahip.Id" class="fw-bold">@sahip.KisaAd</a>
                            @if (sahip.OgrenciDogrulandi)
                            {
                                <div><span class="badge bg-success">✓ Doğrulanmış öğrenci</span></div>
                            }
                        </div>
                    </div>

                    @if (sahibi)
                    {
                        <div class="d-grid gap-2">
                            <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-primary">Düzenle</a>
                            <form asp-action="Sil" asp-route-id="@Model.Id" method="post"
                                  onsubmit="return confirm('Bu ilanı silmek istediğine emin misin?');">
                                <button type="submit" class="btn btn-outline-danger w-100">Sil</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="d-grid gap-2">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <a asp-controller="Mesaj" asp-action="Yeni" asp-route-kullaniciId="@sahip.Id" asp-route-ilanId="@Model.Id"
                                   class="btn btn-primary">✉ İletişime geç</a>
                                <form asp-controller="Favori" asp-action="Degistir" method="post">
                                    <input type="hidden" name="ilanId" value="@Model.Id" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="btn btn-outline-secondary w-100">
                                        @(favoride ? "♥ Favorilerden çıkar" : "♡ Favorilere ekle")
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path"
                                   class="btn btn-primary">✉ İletişime geçmek için giriş yap</a>
                            }
                        </div>
                    }
                </div>
            </div>

            @if (!sahibi)
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h6">Güvenlik hatırlatması</h2>
                        <p class="small">
                            Evi görmeden kapora ya da önden ödeme yapma. Kişisel ve finansal bilgilerini paylaşmadan önce
                            ilan sahibinin doğrulama rozetini kontrol et.
                        </p>
                        <a asp-controller="Sikayet" asp-action="Olustur" asp-route-ilanId="@Model.Id" class="btn btn-sm btn-outline-danger">⚑ Bu ilanı şikayet et</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
