@model List<Ilan>
@{
    ViewData["Title"] = "İlanlarım";
    var tr = new System.Globalization.CultureInfo("tr-TR");
}

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

<div class="sayfa-ust d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <span class="ust-etiket">Hesabım</span>
        <h1>İlanlarım</h1>
        <p>Verdiğin ilanları düzenle, yayından kaldır ya da sil.</p>
    </div>
    <a asp-action="Olustur" class="ea-btn ea-btn-ana">+ Yeni ilan</a>
</div>

@if (!Model.Any())
{
    <div class="bos-durum">
        Henüz ilan vermedin.<br />
        <a asp-action="Olustur" class="ea-btn ea-btn-ana">İlk ilanını ver</a>
    </div>
}
else
{
    <div class="satir-liste">
        @foreach (var ilan in Model)
        {
            var kapak = ilan.Fotolar.FirstOrDefault()?.Yol;
            <div class="satir-kart">
                @if (kapak != null)
                {
                    <img src="@kapak" alt="" class="kucuk-foto" />
                }
                else
                {
                    <div class="kucuk-foto">Fotoğraf yok</div>
                }

                <div class="govde">
                    <a asp-action="Detay" asp-route-id="@ilan.Id" class="baslik">@ilan.Baslik</a>
                    <div class="small text-muted mb-2">@ilan.Ilce · @ilan.Sehir · Eklenme: @ilan.OlusturmaTarihi.ToLocalTime().ToString("d MMMM yyyy", tr) · @ilan.Fotolar.Count fotoğraf</div>
                    <div class="etiketler mb-0">
                        <span class="etiket @(ilan.Aktif ? "dolu" : "vurgu")">@(ilan.Aktif ? "Yayında" : "Yayında değil")</span>
                        <span class="etiket">@ilan.OdaTipi.GorunenAd()</span>
                        <span class="etiket">@ilan.Kira.ToString("N0", tr)₺ / ay</span>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Duzenle" asp-route-id="@ilan.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <form asp-action="YayinDurumu" asp-route-id="@ilan.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">@(ilan.Aktif ? "Yayından kaldır" : "Yayınla")</button>
                    </form>
                    <form asp-action="Sil" asp-route-id="@ilan.Id" method="post"
                          onsubmit="return confirm('Bu ilanı silmek istediğine emin misin?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
