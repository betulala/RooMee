@model List<Ilan>
@{
    ViewData["Title"] = "İlanlarım";
}

@if (TempData["Mesaj"] is string mesaj)
{
    <div class="alert alert-success">@mesaj</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">İlanlarım</h1>
    <a asp-action="Olustur" class="btn btn-primary">+ Yeni ilan</a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        Henüz ilan vermedin.<br />
        <a asp-action="Olustur" class="btn btn-outline-primary mt-3">İlk ilanını ver</a>
    </div>
}
else
{
    <div class="list-group shadow-sm">
        @foreach (var ilan in Model)
        {
            var kapak = ilan.Fotolar.FirstOrDefault()?.Yol;

            <div class="list-group-item d-flex flex-wrap align-items-center gap-3 py-3">
                @if (kapak != null)
                {
                    <img src="@kapak" alt="" class="rounded" style="width:120px;height:90px;object-fit:cover" />
                }
                else
                {
                    <div class="rounded bg-light border d-flex align-items-center justify-content-center text-muted small"
                         style="width:120px;height:90px">
                        Fotoğraf yok
                    </div>
                }

                <div class="flex-grow-1">
                    <a asp-action="Detay" asp-route-id="@ilan.Id" class="fw-semibold text-decoration-none">@ilan.Baslik</a>
                    @if (ilan.Aktif)
                    {
                        <span class="badge bg-success ms-1">Yayında</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-1">Yayında değil</span>
                    }
                    <div class="small text-muted">
                        @ilan.Ilce, @ilan.Sehir · @ilan.OdaTipi.GorunenAd() · @ilan.Kira.ToString("N0") TL / ay
                    </div>
                    <div class="small text-muted">
                        Eklenme: @ilan.OlusturmaTarihi.ToLocalTime().ToString("dd.MM.yyyy") · @ilan.Fotolar.Count fotoğraf
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Duzenle" asp-route-id="@ilan.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>

                    <form asp-action="YayinDurumu" asp-route-id="@ilan.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(ilan.Aktif ? "Yayından kaldır" : "Yayınla")
                        </button>
                    </form>

                    <form asp-action="Sil" asp-route-id="@ilan.Id" method="post"
                          onsubmit="return confirm('Bu ilanı silmek istediğine emin misin?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </div>
            </div>
        }
    </div>
}