@model Ilan
@{
    var kapak = Model.Fotolar.FirstOrDefault()?.Yol;
    var tr = new System.Globalization.CultureInfo("tr-TR");

    // Kalp butonu sadece giriş yapmış kullanıcıya ve başkasının ilanında görünür (ilan listesinde)
    var favoriIdleri = ViewData["FavoriIdleri"] as HashSet<int>;
    bool kalpGoster = favoriIdleri != null && Model.KullaniciId != ViewData["BenimId"] as string;
    bool favoride = favoriIdleri?.Contains(Model.Id) == true;
}
<div class="kart-sarmal">
    <a asp-controller="Ilan" asp-action="Detay" asp-route-id="@Model.Id" class="kisi-karti ilan-karti"
       aria-label="@Model.Baslik ilanını görüntüle">
        <div class="ilan-foto">
            @if (kapak != null)
            {
                <img src="@kapak" alt="" loading="lazy" />
            }
            else
            {
                <span>Fotoğraf yok</span>
            }
        </div>
        <div class="ilan-govde">
            <h2>@Model.Baslik</h2>
            <span class="konum">@Model.Ilce · @Model.Sehir.ToUpper(tr)</span>

            <div class="etiketler">
                <span class="etiket dolu">@Model.OdaTipi.GorunenAd()</span>
                @if (Model.SadeceOgrenci) { <span class="etiket">Öğrenci arıyor</span> }
                @if (Model.SigaraIcmeyen) { <span class="etiket">Sigara içmeyen</span> }
                @if (Model.Sessiz) { <span class="etiket">Sessiz</span> }
                @if (Model.EvcilHayvanKabul) { <span class="etiket">Evcil hayvan kabul</span> }
                @if (Model.Kullanici?.OgrenciDogrulandi == true) { <span class="etiket vurgu">Doğrulanmış öğrenci</span> }
                @if (!Model.Aktif) { <span class="etiket vurgu">Yayında değil</span> }
            </div>

            @if (Model.Kullanici != null)
            {
                <div class="ilan-sahibi">
                    <partial name="~/Views/Kullanici/_Avatar.cshtml" model="Model.Kullanici" />
                    <span>@Model.Kullanici.KisaAd</span>
                </div>
            }

            <div class="kart-alt">
                <div class="fiyat">@Model.Kira.ToString("N0", tr)₺<span> / ay</span></div>
                <span class="ea-btn ea-btn-sade ea-btn-kucuk">Detay Gör</span>
            </div>
        </div>
    </a>

    @if (kalpGoster)
    {
        <form asp-controller="Favori" asp-action="Degistir" method="post">
            <input type="hidden" name="ilanId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
            <button type="submit" class="kalp-butonu" title="@(favoride ? "Favorilerden çıkar" : "Favorilere ekle")"
                    aria-label="@(favoride ? "Favorilerden çıkar" : "Favorilere ekle")">
                @(favoride ? "♥" : "♡")
            </button>
        </form>
    }
</div>
